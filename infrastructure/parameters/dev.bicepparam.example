using '../main.bicep'
param namePrefix = 'verejnydohlad'
param location = 'westeurope'
param openAiResourceName = 'myAItest'
param openAiResourceGroup = 'AI'
param openAiEndpoint = 'https://myaitest.openai.azure.com/'
param openAiDeployment = 'gpt-4.1-mini'
param openAiEditorDeployment = 'gpt-4.1'
// This instance has the approved editor deployment; preserve automatic publication on redeploy.
param autoPublishEnabled = true
param researchFlowEnabled = true
param maxArticlesPerDay = 6
param maxPublishedArticlesPerDay = 3
param maxPressReleasesPerRun = 40
param maxAiCallsPerDay = 40
// Supply existing Application Insights securely during deployment, or provision an optional
// component against an existing workspace. No extra Storage Account is ever provisioned.
param createApplicationInsights = false
